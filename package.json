{
  "name": "onfactory-erp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names web,api --prefix-colors cyan,magenta \"vite\" \"node --watch server/index.mjs\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.mjs",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "build:sites": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build --config vite.sites.config.ts && node scripts/stage-sites-build.mjs",
    "preview": "vite preview",
    "preview:sites": "vite preview --config vite.sites.config.ts",
    "start": "node server/index.mjs",
    "test:server": "node --experimental-strip-types --test server/*.test.mjs server/store/*.test.mjs scripts/*.test.mjs worker/*.test.mjs",
    "test:pg": "node --experimental-strip-types --test server/store/*.test.mjs scripts/migrate-json-to-pg.test.mjs scripts/seed-demo.test.mjs",
    "test:pg:e2e": "node scripts/run-postgres-e2e.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:migrate:json": "node scripts/migrate-json-to-pg.mjs",
    "db:seed": "node scripts/seed-demo.mjs",
    "verify:architecture": "node scripts/verify-architecture.mjs",
    "verify:design": "node scripts/verify-design-tokens.mjs",
    "verify": "pnpm verify:architecture && pnpm verify:design && pnpm verify:button",
    "backup:data": "node server/backup-data.mjs",
    "restore:data": "node server/restore-data.mjs",
    "verify:button": "node scripts/verify-button-tone.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@aws-sdk/client-s3": "^3.1113.0",
    "@aws-sdk/s3-request-presigner": "^3.1113.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "latest",
    "pg": "^8.23.0",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^5.20260819.1",
    "@openai/sites-vite-plugin": "0.1.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "^10.0.5",
    "pg-mem": "^3.0.14",
    "supabase": "^2.115.0",
    "typescript": "latest",
    "vite": "latest",
    "wrangler": "4.92.0"
  }
}
