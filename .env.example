# 이 파일을 .env.local로 복사한 뒤 값을 입력하세요. .env.local은 Git에서 제외됩니다.
# Anthropic Console에서 발급한 서버용 API 키 (브라우저에 노출되는 VITE_ 접두사를 사용하지 마세요.)
ANTHROPIC_API_KEY=

# 기본값: claude-sonnet-5
CLAUDE_MODEL=claude-sonnet-5

# 외부 배포의 초기 관리자용 임시 비밀번호입니다. 12자 이상 강한 값으로
# Sites의 secret에만 저장하며, 설정된 경우 첫 로그인에서 변경을 강제합니다.
# 로컬 데모에서는 비워 두세요.
ERP_SEED_PASSWORD=

# Sites에 이미 저장된 통합 운영자·3D뮤즈 관리자 계정의 접근을 복구할 때만
# 사용하는 1회성 값입니다. VERSION을 비어 있지 않은 새 revision 문자열로
# 바꾸면 아래 두 비밀번호가 해당 계정에 한 번만 반영되고, 첫 로그인에서
# 변경을 강제합니다. 같은 VERSION은 다시 적용되지 않습니다.
# 실제 비밀번호는 이 파일이나 Git에 기록하지 말고 Sites secret에만 저장하세요.
ERP_ACCOUNT_RECOVERY_VERSION=
ERP_OPERATOR_RECOVERY_PASSWORD=
ERP_3DMUSE_RECOVERY_PASSWORD=

# API/운영 서버 리스닝 설정
HOST=127.0.0.1
PORT=8787

# 바깥에서 이 서버를 부르는 주소(https://erp.example.com). 게스트 초대 링크와 외부 연동의
# 수신 주소가 이 값으로 만들어집니다. 비워 두면 요청의 Host 헤더를 쓰므로, 프록시 뒤에서는
# 관리자에게 회사 도메인이 아닌 주소가 보일 수 있습니다.
APP_PUBLIC_URL=

# 고객사별 영구 데이터 디렉터리. JSON 상태와 기업 자료 원본을 함께 둡니다.
ONFACTORY_DATA_DIRECTORY=server/data

# JSON 파일만 별도 위치로 둘 때 사용합니다. 비워두면 위 디렉터리의 workspace-state.json을 사용합니다.
WORKSPACE_STORE_FILE=

# 운영 저장소. 기본값은 postgres입니다. 로컬 Supabase는 pnpm db:start로 실행합니다.
STORE_BACKEND=postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
STORE_AUTO_MIGRATE=false
STORE_ALLOW_JSON_FALLBACK=true

# Postgres 장애 시 JSON fallback은 기본 읽기 전용입니다. 이관 전 로컬 JSON을
# 명시적으로 계속 쓸 때만 STORE_BACKEND=json, STORE_JSON_READONLY=false로 설정하세요.
STORE_JSON_READONLY=true

# scripts/seed-demo.mjs에서만 사용하는 12자 이상 임시 암호입니다.
# 운영 secret으로 주입하고 저장소에 실제 값을 커밋하지 마세요.
DEMO_SEED_PASSWORD=

# 기업 자료 파일 저장소: local 또는 s3
FILE_STORAGE_BACKEND=local
FILE_STORAGE_LOCAL_DIRECTORY=server/data/documents
S3_BUCKET=
S3_REGION=ap-northeast-2
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_EXPIRES_SECONDS=300

# 외부 기회 인제스트 (입찰·지원사업). 외부 워커가 결과를 밀어넣을 때 쓰는 서버 간 토큰.
# 설정하지 않으면 /api/opportunities/ingest는 503으로 닫혀 있습니다. 32자 이상을 권장합니다.
OPPORTUNITY_INGEST_TOKEN=

# 백업 이중화 (야간 DB 덤프 → NAS, 파일·덤프 → 클라우드 버킷).
# 복구 절차는 README "백업 이중화와 복구"를 따릅니다.
BACKUP_ENABLED=
BACKUP_NAS_DIRECTORY=
BACKUP_CLOUD_BUCKET=
BACKUP_CLOUD_PREFIX=inthefield-backup
BACKUP_RETENTION_GENERATIONS=14
BACKUP_SCHEDULE_HOUR=3
BACKUP_INTERVAL_HOURS=24

# 공고 피드 (읽기 전용 공공데이터). 키가 없는 출처는 목록에서 조용히 빠지고,
# 화면에는 "연동키 설정 후 함께 표시됩니다"라고만 안내합니다.
# K-Startup은 키가 없어도 공식 페이지의 공고 제목만 가져옵니다.
KSTARTUP_SERVICE_KEY=
BIZINFO_CERT_KEY=
BIZINFO_COMMERCIAL_USE_APPROVED=
# 나라장터(조달청) 입찰공고 · 울산광역시 고시·공고 — 공공데이터포털 서비스키
G2B_SERVICE_KEY=
ULSAN_SERVICE_KEY=

# 웹푸시(VAPID). 키가 없으면 알림 센터는 그대로 동작하고 푸시 등록만 닫힙니다.
# 키 생성: node -e "import('./server/web-push.mjs').then(m => console.log(m.generateVapidKeys()))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# R16-L 외부 연동. 발신 웹훅의 HMAC 서명키는 서명할 때 원문이 필요해 해시로 둘 수 없습니다 —
# 대신 이 키로 봉인해 저장합니다(AES-256-GCM, AAD=엔드포인트 id). 키는 여기에만 있습니다.
# 없으면 보내는 엔드포인트 생성이 503으로 막힙니다(서명 없는 발신은 만들지 않습니다).
# 키 생성: node -e "import('./server/secret-box.mjs').then((m) => console.log(m.generateSecretBoxKey()))"
# (openssl이 있으면 openssl rand -base64 32 도 같은 값입니다 — 32바이트 base64)
SECRET_BOX_KEY=
# 알림톡 어댑터. 지금은 console만 있습니다(실제 발신기는 발신 프로필이 정해진 뒤에 붙입니다).
# 비워 두면 알림 설정 표에 알림톡 열이 아예 생기지 않습니다 — 켤 수 없는 체크박스를 그리지 않습니다.
KAKAO_TRANSPORT=
# 알림 메일은 MAIL_TRANSPORT를 그대로 씁니다(게스트 초대·비밀번호 재설정과 같은 통로).

# R16-E 구글 캘린더 양방향 동기화.
# Google Cloud Console → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID → 웹 애플리케이션에서
# 직접 발급합니다. 승인된 리디렉션 URI에 아래 GOOGLE_OAUTH_REDIRECT_URI와 **똑같은 문자열**을 등록해야 합니다.
# 필요한 범위는 두 개입니다: calendar.events, calendar.calendarlist.readonly
# 셋 중 하나라도 비면 일정 화면은 버튼 대신 "연동키 설정 후 사용할 수 있습니다."만 보여 줍니다.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8787/oauth/google/callback
# 구글 토큰도 SECRET_BOX_KEY로 봉인해 저장합니다(AAD=google-calendar:<고객사>:<계정>).
# 키가 없으면 연결 자체가 503으로 막힙니다 — 토큰이 평문으로 저장되는 일은 없습니다.

# R16-M 회의 음성 전사. 실제 음성 벤더는 아직 정해지지 않았습니다 — 지금 쓸 수 있는 값은
# none(전사하지 않음)과 text(사람이 올린 회의록 원문 .txt·.vtt·.srt·.md를 읽음) 둘뿐이고,
# 그 밖의 값을 넣으면 부팅에서 막힙니다(설정 실수를 조용히 none으로 떨어뜨리지 않습니다).
# 아래 세 줄은 벤더가 정해졌을 때 쓸 이름 자리이며 지금은 아무도 읽지 않습니다.
# 기본값은 text입니다 — 사람이 올린 회의록 원문에서 글자를 옮기는 데는 벤더도 네트워크도 필요 없습니다.
# 회의록 기능 자체를 끄려면 none으로 두세요(그때는 원문 업로드도 받지 않습니다).
# 음성(.m4a 등)은 이 값과 무관하게 아직 안 됩니다 — 벤더가 정해지지 않았습니다.
TRANSCRIPTION_PROVIDER=text
# TRANSCRIPTION_ENDPOINT=
# TRANSCRIPTION_API_KEY=
# TRANSCRIPTION_MODEL=
